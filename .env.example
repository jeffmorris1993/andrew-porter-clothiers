# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Model used for web research and synthesis (default gpt-5.4-mini).
OPENAI_MODEL=gpt-5.4-mini
# minimal | low | medium | high | none
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=90000
# Per-client limits per 10 minutes, and a per-instance daily cap on model calls.
RATE_LIMIT_RESEARCH=12
RATE_LIMIT_ASSIST=30
MAX_DAILY_MODEL_CALLS=400
